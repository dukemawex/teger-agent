# Required for SERV Reasoning (OpenServ). Without it the agent runs a deterministic fallback planner.
SERV_API_KEY=
# Optional: any model id from the SERV catalog (default gpt-5.4-mini)
SERV_MODEL=gpt-5.4-mini
# Required in production: signs sessions and encrypts stored inbox credentials (openssl rand -hex 32)
AUTH_SECRET=
# Required in production: accounts, history, lists (otherwise in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: web brand research via Parallel search
PARALLEL_API_KEY=
# Optional: isolated screenshots via Instabox (both required)
INSTABOX_API_KEY=
INSTABOX_SCREENSHOT_URL=
# Optional: set to 1 to disable all outbound lookups
TEGER_OFFLINE=
# Gmail via Composio (needs Session management, Connected accounts, Tool execution write permissions)
COMPOSIO_API_KEY=
# Optional: Composio trigger webhook signing secret (auto-scan new mail)
COMPOSIO_WEBHOOK_SECRET=
# Optional: Sign in with Google + Gmail OAuth (redirect URI: <APP_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=
